<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_background">

    <!-- Remote video (full screen) -->
    <FrameLayout
        android:id="@+id/remoteVideoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/call_background">

        <TextView
            android:id="@+id/tvContactName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Caller Name"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="24dp" />

    </FrameLayout>

    <!-- Local video (PIP) -->
    <FrameLayout
        android:id="@+id/localVideoContainer"
        android:layout_width="120dp"
        android:layout_height="180dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:background="@color/call_muted"
        android:elevation="8dp" />

    <!-- Call Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="24dp"
        android:layout_marginBottom="40dp">

        <ImageButton
            android:id="@+id/btnMute"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_mic"
            android:background="@drawable/call_button_bg"
            android:contentDescription="@string/mute"
            android:tint="@color/text_white" />

        <ImageButton
            android:id="@+id/btnEndCall"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/ic_call_end"
            android:background="@drawable/call_end_button_bg"
            android:contentDescription="@string/end_call"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:tint="@color/text_white" />

        <ImageButton
            android:id="@+id/btnCamera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_videocam"
            android:background="@drawable/call_button_bg"
            android:contentDescription="@string/camera"
            android:tint="@color/text_white" />

        <ImageButton
            android:id="@+id/btnSwitchCamera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_switch_camera"
            android:background="@drawable/call_button_bg"
            android:contentDescription="@string/switch_camera"
            android:layout_marginStart="12dp"
            android:tint="@color/text_white" />

    </LinearLayout>

</RelativeLayout>
